              "z": 4,
              "threats": [
                {
                  "status": "Open",
                  "severity": "High",
                  "title": "Client-side role manipulation",
                  "type": "Elevation of privilege",
                  "description": "An attacker can modify the role value stored in browser localStorage and attempt to access administrator functionality without having administrator privileges.",
                  "mitigation": "Never trust role or permission values stored in the browser. Verify user roles and permissions on the server for every protected request."
                },
                {
                  "status": "Open",
                  "severity": "High",
                  "title": "Sensitive information exposed in source code",
                  "type": "Information disclosure",
                  "description": "Passwords, CNIC information, API keys or other sensitive information may be exposed if developers place them in client-side HTML or JavaScript code.",
                  "mitigation": "Never store passwords, private API keys or sensitive personal information in frontend source code. Keep secrets on the server and use environment variables for configuration."
                }
              ],
              "isWebApplication": true,
              "privilegeLevel": "Limited",
