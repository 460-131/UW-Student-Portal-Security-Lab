              "threats": [
                {
                  "status": "Open",
                  "severity": "High",
                  "title": "Cross-site scripting in search results",
                  "type": "Tampering",
                  "description": "An attacker can submit malicious HTML or JavaScript through the search input. If the application renders the input using an unsafe method such as innerHTML, the script may execute in another user's browser.",
                  "mitigation": "Validate and sanitize user input. Use textContent instead of innerHTML for plain text output. Apply context-aware output encoding and implement a Content Security Policy."
                },
                {
                  "status": "Open",
                  "severity": "High",
                  "title": "Unauthorized access to student results",
                  "type": "Information disclosure",
                  "description": "A student may change a result ID in a request and access another student's academic results if the server does not verify record ownership.",
                  "mitigation": "Perform server-side authorization checks on every result request. Verify that the authenticated student is authorized to access the requested record."
                }
              ],
              "isWebApplication": true,
